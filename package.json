{
  "name": "forma-3d-viewer-v3",
  "version": "3.0.0",
  "private": true,
  "description": "FORMA 3D - Qiong Opera Digital Figurine Showcase + AI Asset Pipeline. Three.js based offline-capable viewer with local analysis backend.",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "start": "node serve.mjs",
    "vendor": "node tools/vendor-three.mjs",
    "vendor:check": "node tools/vendor-three.mjs --check",
    "assets:extract": "node tools/extract-glb.mjs",
    "assets:fix": "node tools/fix-glb.mjs",
    "assets:verify": "node tools/verify-glb.mjs",
    "assets:all": "node tools/extract-glb.mjs && node tools/fix-glb.mjs && node tools/verify-glb.mjs",
    "ao": "node tools/make-contact-ao.mjs",
    "test": "node tests/run.mjs",
    "test:gpu": "node tests/run.mjs --gpu",
    "shots": "node tests/run.mjs --only=shots",
    "shots:gpu": "node tests/run.mjs --only=shots --gpu",
    "pipeline:serve": "node backend/server.mjs",
    "test:pipeline": "node tests/run.mjs --only=pipeline",
    "test:agent": "node tests/run.mjs --only=agent",
    "agent:spike": "node tools/llm-tools-spike.mjs",
    "test:ops": "node tests/run.mjs --only=ops",
    "op:demo": "node tools/op-demo.mjs",
    "test:batch": "node tests/run.mjs --only=batch",
    "batch:demo": "node tools/batch-demo.mjs",
    "test:proxy": "node tests/run.mjs --only=proxy",
    "release:verify": "node tools/static-release.mjs",
    "release:pack": "node tools/static-release.mjs --pack=dist",
    "test:release": "node tests/run.mjs --only=release"
  },
  "devDependencies": {
    "puppeteer-core": "^22.15.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tencent-ai/workbuddy-cloud-sdk": "^0.1.4-dev.ca27990.202610161713",
    "meshoptimizer": "^1.3.0",
    "postprocessing": "^6.39.5",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  }
}
