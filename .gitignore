# Dependencies
node_modules/

# Generated test artefacts (regenerable via tools/*.mjs)
test-out/

# Derived study variants - regenerated by tools/fix-glb.mjs with the flags
# listed in docs/normals-study.md. The ORIGINAL assets in assets/raw/ are kept.
assets/variants/

# OS noise
Thumbs.db
.DS_Store

# ---- AI Asset Pipeline (v4) ----

# Backend runtime state: uploaded/derived assets are user data, never committed
backend/workspace/

# Secrets - API keys must NEVER enter the repo (see docs/SECURITY.md)
backend/.env

# Pipeline run outputs (regenerable; original assets are never touched)
pipeline-out/

# Published library artifacts (regenerable via tools/batch-demo.mjs; keep local, not in repo)
assets/library/

# Demo capture frames (large, regenerable via docs/demo/README.md)
docs/demo/frames/
